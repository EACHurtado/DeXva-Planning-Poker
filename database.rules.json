{
  "rules": {
    "salas": {
      "$sala": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('moderador').val() === auth.uid || !data.child('actividad').exists() || data.child('actividad').val() < now - 86400000)",
        "moderador": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "actividad": {
          ".write": "auth != null && newData.parent().child('moderador').val() === auth.uid",
          ".validate": "newData.val() === now"
        },
        "estado": {
          ".write": "auth != null && newData.parent().child('moderador').val() === auth.uid",
          ".validate": "newData.val() === 'votando' || newData.val() === 'revelado'"
        },
        "mazo": {
          ".write": "auth != null && !data.exists() && newData.parent().child('moderador').val() === auth.uid",
          ".validate": "newData.val() === 'fibonacci' || newData.val() === 'tallas' || newData.val() === 'potencias'"
        },
        "resumen": {
          ".write": "auth != null && newData.parent().child('moderador').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "historiaActual": {
          ".write": "auth != null && newData.parent().child('moderador').val() === auth.uid",
          ".validate": "newData.isString() && newData.parent().child('historias').child(newData.val()).exists()"
        },
        "historias": {
          ".write": "auth != null && newData.parent().child('moderador').val() === auth.uid",
          "$historia": {
            ".validate": "newData.hasChildren(['titulo'])",
            "titulo": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "estimacion": {
              ".validate": "newData.isString() && newData.val().length <= 4"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "participantes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('salas').child($sala).child('moderador').exists()",
            ".validate": "newData.hasChildren(['nombre', 'conectado'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "conectado": {
              ".validate": "newData.isBoolean()"
            },
            "espectador": {
              ".validate": "newData.isBoolean()"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "votos": {
          ".write": "auth != null && root.child('salas').child($sala).child('moderador').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('salas').child($sala).child('estado').val() === 'votando'",
            ".validate": "newData.isString() && newData.val().length <= 4"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
